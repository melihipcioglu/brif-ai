{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BRIF.AI Assistant Action Schema (Demo Contract)",
  "description": "Structure defining how user intent is mapped into structured architectural operations prior to geometry engine execution.",
  "type": "object",
  "properties": {
    "intent": {
      "type": "string",
      "enum": [
        "resize_space",
        "move_space",
        "swap_spaces",
        "lock_space",
        "unlock_space",
        "remove_space",
        "add_space",
        "change_preference",
        "ask_why",
        "ask_impact",
        "undo",
        "compare_alternatives",
        "regulation_question",
        "ergonomics_question",
        "usage_mismatch_request",
        "ambiguous_request"
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "space_id": { "type": "string" },
        "floor": { "type": "string", "enum": ["ground", "upper"] },
        "alternative": { "type": "string", "enum": ["a", "b"] },
        "second_space_id": { "type": ["string", "null"] }
      },
      "required": ["space_id", "floor", "alternative"]
    },
    "operation": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["resize", "drag", "swap", "lock", "unlock", "delete", "add", "rename_attempt"] },
        "requested_area_range": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "new_position": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          }
        },
        "new_dimensions": {
          "type": "object",
          "properties": {
            "width": { "type": "number" },
            "height": { "type": "number" }
          }
        }
      },
      "required": ["type"]
    },
    "preserve": {
      "type": "array",
      "items": { "type": "string" }
    },
    "effects": {
      "type": "array",
      "items": { "type": "string" }
    },
    "requires_confirmation": { "type": "boolean" },
    "source_message": { "type": "string" }
  },
  "required": [
    "intent",
    "target",
    "operation",
    "preserve",
    "effects",
    "requires_confirmation",
    "source_message"
  ],
  "example_instance": {
    "intent": "resize_space",
    "target": {
      "space_id": "study",
      "floor": "ground",
      "alternative": "b"
    },
    "operation": {
      "type": "resize",
      "requested_area_range": [10, 11]
    },
    "preserve": [
      "kitchen_area",
      "total_enclosed_area"
    ],
    "effects": [
      "children_room_area",
      "circulation_ratio"
    ],
    "requires_confirmation": true,
    "source_message": "Çalışma odası 14 m² olmasın, 10–11 m² yeterli."
  }
}
