{
  "name": "yokdil-fen-phase-one",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "dev": "vite --config vite.app.config.ts",
    "build:app": "vite build --config vite.app.config.ts",
    "preview:app": "vite preview --config vite.app.config.ts",
    "phone": "npm run build:app && npm run preview:app",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "dexie": "^4.0.11",
    "lucide-react": "^1.49.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "fake-indexeddb": "^6.0.1",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.1",
    "vitest": "4.1.11"
  }
}
